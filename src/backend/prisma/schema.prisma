generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum TranslationStatus {
  DRAFT
  REVIEWED
  PUBLISHED
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  INACTIVE
  INVITED
  SUSPENDED
  CLOSED
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  INVITED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum AuditResult {
  SUCCESS
  FAILURE
  DENIED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum AssignmentType {
  COACH
  SUPPORT
}

enum BodyCompositionReference {
  MALE
  FEMALE
}

enum BodyCompositionReferenceBasis {
  BIRTH_SEX
  HORMONE_THERAPY
}

enum BodyWeightSource {
  MANUAL
  MEASUREMENT_SESSION
  SMART_SCALE
  APPLE_HEALTH
  HEALTH_CONNECT
  FITBIT
  GARMIN
  WITHINGS
  IMPORT
  SYNTHETIC
}

model User {
  id                                     String                         @id @default(uuid())
  email                                  String                         @unique
  passwordHash                           String
  firstName                              String
  lastName                               String?
  status                                 UserStatus                     @default(ACTIVE)
  mustChangePassword                     Boolean                        @default(false)
  tokenVersion                           Int                            @default(0)
  lastLoginAt                            DateTime?
  emailVerifiedAt                        DateTime?
  mfaEnabled                             Boolean                        @default(false)
  mfaSecretEncrypted                     String?
  mfaRecoveryCodeHashes                  Json?
  heightCm                               Float?
  sexAssignedAtBirth                     String?
  genderIdentity                         String?
  usesGenderAffirmingHormones            Boolean?
  hormoneTherapyStartDate                DateTime?
  bodyCompositionEquationPreference      String                         @default("ASSIGNED_SEX_REFERENCE")
  bodyCompositionEstimateConsent         Boolean                        @default(false)
  bodyCompositionReference               BodyCompositionReference?
  bodyCompositionReferenceBasis          BodyCompositionReferenceBasis?
  hasCompletedTwelveMonthsHormoneTherapy Boolean                        @default(false)
  preferredWeightUnit                    String                         @default("lb")
  preferredLengthUnit                    String                         @default("in")
  preferredHydrationUnit                 String                         @default("oz")
  preferredLanguage                      String                         @default("en")
  preferredDateFormat                    String                         @default("LOCALE")
  preferredTimeFormat                    String                         @default("12")
  preferredWeekStart                     String                         @default("SUNDAY")
  timezone                               String                         @default("UTC")
  countryCode                            String                         @default("US")
  dailyHydrationGoal                     Float                          @default(64)
  dailyHydrationGoalMl                   Float                          @default(1892.7)
  targetWeight                           Float?
  targetWeightKg                         Float?
  createdAt                              DateTime                       @default(now())
  updatedAt                              DateTime                       @updatedAt

  measurements                 Measurement[]
  measurementSessions          MeasurementSession[]
  bodyWeights                  BodyWeight[]
  targetedSyntheticDataBatches SyntheticDataBatch[]     @relation("SyntheticDataBatchTarget")
  createdSyntheticDataBatches  SyntheticDataBatch[]     @relation("SyntheticDataBatchCreator")
  hydrationLogs                Hydration[]
  translationChanges           TranslationHistory[]
  translationUpdates           TranslationValue[]       @relation("TranslationValueUpdater")
  memberships                  OrganizationMembership[]
  createdInvitations           Invitation[]             @relation("InvitationCreator")
  acceptedInvitationsByUserId  Invitation[]             @relation("InvitationAcceptorByUserId")
  sessions                     UserSession[]
  auditEvents                  AuditLog[]               @relation("AuditActor")
  subscriptions                UserSubscription[]
  assignmentsAsStaff           DataAssignment[]         @relation("AssignmentStaff")
  assignmentsAsSubject         DataAssignment[]         @relation("AssignmentSubject")

  @@index([status])
  @@map("users")
}

model Organization {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  displayName String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships OrganizationMembership[]
  roles       Role[]
  invitations Invitation[]
  auditLogs   AuditLog[]
  assignments DataAssignment[]
  settings    OrganizationSetting[]

  @@index([isActive])
  @@map("organizations")
}

model OrganizationMembership {
  id             String           @id @default(uuid())
  userId         String
  organizationId String
  status         MembershipStatus @default(ACTIVE)
  joinedAt       DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roles        MembershipRole[]

  @@unique([userId, organizationId])
  @@index([organizationId, status])
  @@index([userId, status])
  @@map("organization_memberships")
}

model Role {
  id             String   @id @default(uuid())
  organizationId String?
  key            String
  name           String
  description    String?
  isSystem       Boolean  @default(false)
  isProtected    Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  memberships  MembershipRole[]
  invitations  Invitation[]

  @@unique([organizationId, key])
  @@index([organizationId, isActive])
  @@index([isSystem])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  category    String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]

  @@index([category])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model MembershipRole {
  membershipId String
  roleId       String
  assignedAt   DateTime @default(now())

  membership OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role                   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
  @@index([roleId])
  @@map("membership_roles")
}

model Invitation {
  id               String           @id @default(uuid())
  organizationId   String
  email            String
  roleId           String?
  status           InvitationStatus @default(PENDING)
  tokenHash        String           @unique
  expiresAt        DateTime
  createdByUserId  String
  acceptedByUserId String?
  acceptedById     String?
  acceptedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role?        @relation(fields: [roleId], references: [id])
  createdBy      User         @relation("InvitationCreator", fields: [createdByUserId], references: [id])
  acceptedByUser User?        @relation("InvitationAcceptorByUserId", fields: [acceptedByUserId], references: [id])

  @@index([organizationId, status])
  @@index([email, status])
  @@index([expiresAt])
  @@map("invitations")
}

model TranslationKey {
  id          String   @id @default(uuid())
  key         String   @unique
  sourceText  String
  category    String   @default("general")
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  translations TranslationValue[]
  history      TranslationHistory[]

  @@index([category])
  @@map("translation_keys")
}

model Language {
  id          String   @id @default(uuid())
  locale      String   @unique
  displayName String
  nativeName  String
  enabled     Boolean  @default(true)
  isSource    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  translations TranslationValue[]

  @@index([enabled])
  @@map("languages")
}

model TranslationValue {
  id               String            @id @default(uuid())
  translationKeyId String
  languageId       String
  value            String
  status           TranslationStatus @default(DRAFT)
  publishedValue   String?
  publishedAt      DateTime?
  updatedById      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  translationKey TranslationKey @relation(fields: [translationKeyId], references: [id], onDelete: Cascade)
  language       Language       @relation(fields: [languageId], references: [id], onDelete: Cascade)
  updatedBy      User?          @relation("TranslationValueUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([translationKeyId, languageId])
  @@index([languageId, status])
  @@index([updatedById])
  @@map("translation_values")
}

model TranslationHistory {
  id               String             @id @default(uuid())
  translationKeyId String
  languageLocale   String
  previousValue    String?
  newValue         String
  previousStatus   TranslationStatus?
  newStatus        TranslationStatus
  action           String
  changedByUserId  String
  changedAt        DateTime           @default(now())

  translationKey TranslationKey @relation(fields: [translationKeyId], references: [id], onDelete: Cascade)
  changedBy      User           @relation(fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([translationKeyId, changedAt])
  @@index([languageLocale, changedAt])
  @@index([changedByUserId, changedAt])
  @@map("translation_history")
}

model Measurement {
  id                       String   @id @default(uuid())
  userId                   String
  measurementDate          DateTime @default(now())
  weight                   Float?
  waist                    Float?
  chest                    Float?
  hips                     Float?
  bodyFat                  Float?
  weightKg                 Float?
  waistCm                  Float?
  chestCm                  Float?
  hipsCm                   Float?
  neck                     Float?
  abdomen                  Float?
  leftBicep                Float?
  rightBicep               Float?
  leftForearm              Float?
  rightForearm             Float?
  leftThigh                Float?
  rightThigh               Float?
  leftCalf                 Float?
  rightCalf                Float?
  neckCm                   Float?
  abdomenCm                Float?
  leftBicepCm              Float?
  rightBicepCm             Float?
  leftForearmCm            Float?
  rightForearmCm           Float?
  leftThighCm              Float?
  rightThighCm             Float?
  leftCalfCm               Float?
  rightCalfCm              Float?
  calculationMethod        String?
  calculationVersion       String?
  fatFreeMassKg            Float?
  equationReference        String?
  calculationInputs        Json?
  syntheticBatchId         String?
  bodyFatMethod            String?
  fatMassKg                Float?
  leanMassKg               Float?
  waistToHeightRatio       Float?
  waistToHeightRatioMethod String?
  measurementSessionId     String?  @unique(map: "measurements_measurementSessionId_key", where: raw("(\"measurementSessionId\" IS NOT NULL)"))
  bodyWeightId             String?  @unique(map: "measurements_bodyWeightId_key", where: raw("(\"bodyWeightId\" IS NOT NULL)"))
  calculationWeightKg      Float?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  syntheticDataBatch SyntheticDataBatch? @relation(fields: [syntheticBatchId], references: [id], onDelete: Cascade)
  measurementSession MeasurementSession? @relation(fields: [measurementSessionId], references: [id])
  bodyWeight         BodyWeight?         @relation(fields: [bodyWeightId], references: [id])

  @@index([userId], map: "measurements_userId_idx")
  @@index([userId, measurementDate])
  @@index([userId, bodyFat])
  @@index([syntheticBatchId])
  @@map("measurements")
}

model MeasurementSession {
  id         String   @id
  userId     String
  recordedAt DateTime
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  measurement Measurement?
  bodyWeight  BodyWeight?

  @@index([userId, recordedAt])
  @@map("measurement_sessions")
}

model BodyWeight {
  id                   String           @id
  userId               String
  measurementSessionId String?          @unique(map: "body_weights_measurementSessionId_key", where: raw("(\"measurementSessionId\" IS NOT NULL)"))
  recordedAt           DateTime
  weightKg             Float
  source               BodyWeightSource @default(MANUAL)
  notes                String?
  syntheticBatchId     String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @default(now())

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  measurementSession MeasurementSession? @relation(fields: [measurementSessionId], references: [id])
  measurement        Measurement?

  @@index([userId, recordedAt])
  @@index([source, recordedAt])
  @@index([syntheticBatchId])
  @@map("body_weights")
}

model SyntheticDataBatch {
  id               String    @id
  targetUserId     String
  createdByUserId  String
  seed             Int
  periodDays       Int
  sexReference     String
  simulatedAge     Int
  bodyProfile      String
  trend            String
  adherence        String    @default("REALISTIC")
  hydrationPattern String    @default("AVERAGE")
  dataTypes        Json
  recordCounts     Json
  status           String    @default("COMPLETED")
  createdAt        DateTime  @default(now())
  deletedAt        DateTime?

  targetUser   User          @relation("SyntheticDataBatchTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  createdBy    User          @relation("SyntheticDataBatchCreator", fields: [createdByUserId], references: [id])
  measurements Measurement[]
  hydration    Hydration[]

  @@index([targetUserId, createdAt])
  @@index([createdByUserId, createdAt])
  @@map("synthetic_data_batches")
}

model Hydration {
  id                   String   @id(map: "hydration_logs_pkey") @default(uuid())
  userId               String
  amount               Float
  unit                 String   @default("oz")
  loggedAt             DateTime @default(now())
  amountMl             Float
  beverageType         String   @default("water")
  hydrationCoefficient Float    @default(1)
  effectiveAmountMl    Float
  syntheticBatchId     String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade, map: "hydration_logs_userId_fkey")
  syntheticDataBatch SyntheticDataBatch? @relation(fields: [syntheticBatchId], references: [id], onDelete: Cascade)

  @@index([userId], map: "hydration_logs_userId_idx")
  @@index([userId, loggedAt], map: "hydration_logs_userId_loggedAt_idx")
  @@index([syntheticBatchId])
  @@index([userId, beverageType, loggedAt], map: "hydration_user_beverage_loggedAt_idx")
  @@map("hydration")
}

model UserSession {
  id                  String    @id @default(uuid())
  userId              String
  tokenHash           String    @unique
  refreshTokenHash    String?   @unique
  userAgent           String?
  ipAddress           String?
  locationCity        String?
  locationRegion      String?
  locationCountry     String?
  locationCountryCode String?
  locationTimezone    String?
  locationLatitude    Float?
  locationLongitude   Float?
  locationProvider    String?
  locationLookedUpAt  DateTime?
  countryCode         String?
  region              String?
  city                String?
  latitude            Float?
  longitude           Float?
  locationSource      String?
  locationCapturedAt  DateTime?
  expiresAt           DateTime
  refreshExpiresAt    DateTime?
  revokedAt           DateTime?
  lastSeenAt          DateTime  @default(now())
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([refreshExpiresAt])
  @@index([expiresAt])
  @@index([locationCountryCode])
  @@index([userId, revokedAt])
  @@map("user_sessions")
}

model AuditLog {
  id             String      @id @default(uuid())
  organizationId String?
  actorUserId    String?
  action         String
  targetType     String
  targetId       String?
  result         AuditResult @default(SUCCESS)
  ipAddress      String?
  userAgent      String?
  requestId      String?
  metadata       Json?
  beforeState    Json?
  afterState     Json?
  createdAt      DateTime    @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor        User?         @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

model SubscriptionPlan {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions UserSubscription[]
  entitlements  PlanEntitlement[]

  @@index([isActive])
  @@map("subscription_plans")
}

model UserSubscription {
  id        String             @id @default(uuid())
  userId    String
  planId    String
  status    SubscriptionStatus @default(ACTIVE)
  startedAt DateTime           @default(now())
  endsAt    DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([planId, status])
  @@index([userId, status, startedAt, endsAt])
  @@map("user_subscriptions")
}

model Entitlement {
  id          String   @id @default(uuid())
  key         String   @unique
  category    String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  plans PlanEntitlement[]

  @@index([category])
  @@map("entitlements")
}

model PlanEntitlement {
  planId        String
  entitlementId String
  createdAt     DateTime @default(now())

  plan        SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  entitlement Entitlement      @relation(fields: [entitlementId], references: [id], onDelete: Cascade)

  @@id([planId, entitlementId])
  @@index([entitlementId])
  @@map("plan_entitlements")
}

model DataAssignment {
  id             String         @id @default(uuid())
  organizationId String
  staffUserId    String
  subjectUserId  String
  assignmentType AssignmentType
  isActive       Boolean        @default(true)
  startsAt       DateTime       @default(now())
  endsAt         DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @default(now()) @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staff        User         @relation("AssignmentStaff", fields: [staffUserId], references: [id], onDelete: Cascade)
  subject      User         @relation("AssignmentSubject", fields: [subjectUserId], references: [id], onDelete: Cascade)

  @@unique([organizationId, staffUserId, subjectUserId, assignmentType], map: "data_assignments_org_staff_subject_type_key")
  @@index([subjectUserId, isActive, endsAt])
  @@index([staffUserId, isActive, endsAt])
  @@index([staffUserId, isActive], map: "data_assignments_staff_active_idx")
  @@index([subjectUserId, isActive], map: "data_assignments_subject_active_idx")
  @@map("data_assignments")
}

model OrganizationSetting {
  id             String   @id @default(uuid())
  organizationId String
  category       String
  key            String
  value          Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([organizationId, category])
  @@map("organization_settings")
}
